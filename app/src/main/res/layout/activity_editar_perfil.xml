<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/gray_background">

        <!-- Fondo rojo superior -->
        <View
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@color/red_1"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Botón hamburguesa -->
        <ImageButton
            android:id="@+id/btnHamburguesa"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@color/red_1"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/navigation"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnRegresar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@color/red_1"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_revert"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            app:tint="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <FrameLayout
            android:id="@+id/frameAvatar"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="70dp"
            android:background="@color/red_800"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/imgPerfil"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/profile_default"
                app:tint="@color/white" />

            <!-- Overlay "editar foto" -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="#99000000"
                android:gravity="center"
                android:paddingVertical="4dp"
                android:text="Cambiar"
                android:textColor="@color/white"
                android:textSize="10sp" />
        </FrameLayout>

        <!-- ScrollView con campos editables -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/frameAvatar"
            app:layout_constraintBottom_toTopOf="@id/bottomNavBar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Usuario -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="USUARIO"
                            android:textColor="@color/gray_text"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/etUsuario"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="4dp"
                            android:background="#F0F0F0"
                            android:hint="r4mon_7u7"
                            android:inputType="text"
                            android:paddingHorizontal="16dp"
                            android:textColorHint="@color/text_gray"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="16dp"
                            android:background="@color/gray_light" />

                        <!-- Nombre -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NOMBRE(S)"
                            android:textColor="@color/gray_text"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/etNombre"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="4dp"
                            android:background="#F0F0F0"
                            android:hint="Ramón"
                            android:inputType="textPersonName"
                            android:paddingHorizontal="16dp"
                            android:textColorHint="@color/text_gray"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="16dp"
                            android:background="@color/gray_light" />

                        <!-- Apellidos -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="APELLIDO(S)"
                            android:textColor="@color/gray_text"
                            android:textSize="11sp" />

                        <EditText
                            android:id="@+id/etApellido"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="4dp"
                            android:background="#F0F0F0"
                            android:hint="García López"
                            android:inputType="textPersonName"
                            android:paddingHorizontal="16dp"
                            android:textColorHint="@color/text_gray"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="16dp"
                            android:background="@color/gray_light" />

                        <!-- Fecha de nacimiento -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FECHA DE NACIMIENTO"
                            android:textColor="@color/gray_text"
                            android:textSize="11sp" />

                        <!-- CAMBIO: focusable false para que abra calendario en vez del teclado -->
                        <EditText
                            android:id="@+id/etFechaNacimiento"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="4dp"
                            android:background="#F0F0F0"
                            android:hint="DD/MM/AAAA"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:cursorVisible="false"
                            android:clickable="true"
                            android:paddingHorizontal="16dp"
                            android:textColorHint="@color/text_gray"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <Button
                    android:id="@+id/btnGuardarCambios"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginBottom="8dp"
                    android:backgroundTint="@color/red_1"
                    android:text="GUARDAR CAMBIOS"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

            </LinearLayout>
        </ScrollView>

        <include
            android:id="@+id/bottomNavBar"
            layout="@layout/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/white"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/nav_menu" />

</androidx.drawerlayout.widget.DrawerLayout>